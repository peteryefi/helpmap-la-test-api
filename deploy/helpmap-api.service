[Unit]
Description=Helpmap Reports API (FastAPI/Uvicorn via Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/helpmap-la-test-api
EnvironmentFile=/home/ubuntu/helpmap-la-test-api/.env
ExecStart=/home/ubuntu/helpmap-la-test-api/.venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
